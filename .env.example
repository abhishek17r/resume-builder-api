# AI keys are NOT set here. Connect OpenAI, Anthropic or Gemini on the app's Integrations page
# (saved in .data/integrations.json on this computer). Keys found here from an older setup are moved
# there once, on first start, and then ignored.

PORT=8787
# Comma-separated frontend origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5190
# AI requests per client per minute
RATE_LIMIT_PER_MIN=20
# Chrome/Chromium/Edge used to make PDFs (found automatically if installed in the usual place)
# CHROME_PATH=
# Demo mode for development and tests: keyword heuristics, no AI calls
# MOCK=1
