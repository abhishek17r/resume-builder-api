# Which AI provider to use: openai | anthropic.
# Leave empty to pick automatically from whichever key is set (Anthropic first). No key → demo mode.
AI_PROVIDER=

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

PORT=8787
# Comma-separated frontend origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5190
# AI requests per client per minute
RATE_LIMIT_PER_MIN=20
